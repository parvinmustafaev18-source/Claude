       бандле остаётся ПРЕЖНЯЯ сборка, а тестирование идёт на ней (сообщение
       латиницей — консоль сборки выводит кириллицу в другой кодировке). -->
  <PropertyGroup>
    <PostBuildEvent>xcopy /Y "$(TargetPath)" "$(APPDATA)\Autodesk\ApplicationPlugins\MeshPlugin.bundle\Contents\" || (echo. &amp;&amp; echo ERROR: cannot copy MeshPlugin.dll into the AutoCAD bundle - the file is locked. Close AutoCAD and rebuild, otherwise AutoCAD will keep running the OLD build. &amp;&amp; exit 1)</PostBuildEvent>
